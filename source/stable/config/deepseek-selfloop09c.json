            },
            "scenario_id": "dependency-schedule-09c-v1",
            "semantics": {
              "idle_allowed": false,
              "position_base": 1,
              "single_machine": true
            },
            "tasks": [
              {
                "duration": 2,
                "id": "A",
                "priority": 2
              },
              {
                "duration": 1,
