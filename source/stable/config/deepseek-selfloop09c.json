{
  "agent": {
    "id": "selfloop09c-agent",
    "version": "1",
    "name": "Constraint scheduling planner",
    "role": "dependency-scheduling-planner",
    "responsibilities": "Generate a feasible sequential schedule from explicit dependencies, priority pairs, windows, blocks and deadlines.",
    "system_prompt": "Return only compact JSON with exactly task, order, total. task is dependency_schedule; order lists all given task IDs once. total is the number of task IDs (8), not cumulative duration or finish time. All tasks run on one machine from time zero with no idle time. Positions are one-based and completion is the cumulative duration including the task. Only the listed priority_before pairs impose priority order; do not assume global priority sorting. Treat every constraint as mandatory. If recovery is present, inspect the actual previous_artifact.content and verification.evidence details and fix the violations without changing the input constraints. Do not add explanations or tools.",
    "skills": [
      "priority-plan"
    ],
    "provider": "deepseek",
    "model": "deepseek-flash",
    "response_format": "text",
    "tools": [],
    "max_concurrency": 1
  },
  "policy": {
    "id": "selfloop09c-rule",
    "version": "2",
    "name": "Frozen dependency scheduling independent checks",
    "checks": [
      {
        "kind": "json_schema",
        "config": {
          "schema": {
            "type": "object",
            "required": [
              "task",
              "order",
              "total"
            ],
            "additionalProperties": false,
            "properties": {
              "task": {
                "const": "dependency_schedule"
              },
              "order": {
                "type": "array",
                "minItems": 8,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E",
                    "F",
                    "G",
                    "H"
                  ]
                }
              },
              "total": {
                "type": "integer"
              }
            }
          }
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-instance-v2"
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-membership-v2"
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-dependencies-v2"
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-priority-v2"
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-adjacency-v2"
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-windows-v2"
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-completion-v2"
        }
      },
      {
        "kind": "external_tests",
        "config": {
          "test_id": "order09c-gap-v2"
        }
      }
    ]
  },
  "workflow": {
    "id": "selfloop09c-template",
    "version": "1",
    "name": "DeepSeek eight-task bounded scheduling challenge",
    "scheduling_strategy": "caas",
    "max_concurrency": 1,
    "timeout_seconds": 60,
    "resource_limits": {
      "max_calls": 2,
      "max_attempts": 2,
      "max_feedback_loops": 1,
      "max_replans": 0,
      "max_checks": 18,
      "max_resource_units": 16384
    },
    "nodes": [
      {
        "id": "schedule",
        "kind": "task",
        "config": {
          "agent_id": "selfloop09c-agent",
          "output_mode": "json",
          "verification": {
            "id": "selfloop09c-rule",
            "version": "2"
          },
          "limits": {
            "max_calls": 1,
            "max_model_calls": 1,
            "max_output_tokens": 256,
            "timeout_seconds": 25,
            "model_timeout_seconds": 15
          },
          "recovery": {
            "max_attempts": 2,
            "max_feedback_loops": 1,
            "max_replans": 0,
            "timeout_seconds": 55,
            "on_failure": "prompt_retry",
            "on_uncertain": "abort",
            "retry_execution_errors": false,
            "feedback_mode": "errors_only"
          },
          "input": {
            "$ref": "input"
          }
        }
      }
    ],
    "edges": [],
    "output_mapping": {
      "schedule": {
        "$ref": "nodes.schedule.output"
      }
    },
    "input_schema": {
      "type": "object",
      "required": [
        "task",
        "instructions",
        "spec"
      ],
      "additionalProperties": false,
      "properties": {
        "task": {
          "const": "dependency_schedule"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "spec": {
