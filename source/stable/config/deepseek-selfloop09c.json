            ]
          }
        }
      }
    }
  },
  "input": {
    "task": "dependency_schedule",
    "instructions": "Find any valid complete order satisfying every listed constraint. Durations are positive integer time units, execution is sequential with no idle time, positions start at 1, deadlines limit completion (not start) time. priority_before lists the only priority ordering requirements. immediately_before requires consecutive positions in that direction. min_gap means position(after)-position(before) is at least min_gap. Return only task, order, total; total is the number of task IDs (8), not the sum of durations; no extra fields.",
    "spec": {
      "scenario_id": "dependency-schedule-09c-v1",
